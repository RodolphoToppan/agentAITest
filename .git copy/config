[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://gitlab.com/agenciawebart/usuarios/clientes/mobiis/mobiis_v2.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
	vscode-merge-base = origin/main
[branch "homolog"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/homolog
[branch "feature/create-header"]
	remote = origin
	merge = refs/heads/feature/create-header
	vscode-merge-base = origin/feature/create-header
[branch "homolog-migration"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/homolog-migration
